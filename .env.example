# ===== App =====
APP_ENV=dev                      # dev | test | prod
LOG_LEVEL=INFO
LOG_JSON=true
CORS_ORIGINS=["http://localhost:5173"]

# ===== LLM (OpenAI) =====
OPENAI_API_KEY=sk-replace-me
OPENAI_BASE_URL=                 # optional (Azure/proxy); blank = api.openai.com
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_SUMMARY_MODEL=            # blank = same as chat model
LLM_PROVIDER=openai              # openai | fake (fake = deterministic offline stub, never in prod)
LLM_MAX_RETRIES=5
LLM_TIMEOUT_SECONDS=60

# ===== Embeddings =====
EMBEDDING_PROVIDER=openai        # openai | fake
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536               # validated against the vector index at startup
EMBEDDING_BATCH_SIZE=64

# ===== Vector store =====
VECTOR_BACKEND=qdrant            # qdrant | pinecone
QDRANT_URL=http://localhost:6333 # ":memory:" runs in-process
QDRANT_API_KEY=
QDRANT_COLLECTION=heirloom_memories
PINECONE_API_KEY=
PINECONE_INDEX=heirloom
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_NAMESPACE=default

# ===== DynamoDB =====
AWS_REGION=us-east-1
DYNAMODB_ENDPOINT_URL=http://localhost:8000   # blank = real AWS (uses standard AWS credential chain)
DYNAMODB_TABLE=heirloom

# ===== Hybrid retrieval =====
W_SIM=0.6
W_REC=0.2
W_IMP=0.2
DECAY=0.05                       # per day; half-life ≈ ln2/DECAY ≈ 13.9 days
CANDIDATE_MULTIPLIER=4
DEFAULT_TOP_K=8
DEFAULT_MIN_SCORE=0.0

# ===== Summaries =====
ROLLING_BUFFER_MAX_TOKENS=3000
ROLLING_CHUNK_MESSAGES=12        # must be even (never split user/assistant pairs)
ROLLING_SUMMARY_MAX_TOKENS=800
SECTION_FANOUT=5

# ===== Context assembler budgets (tokens) =====
CONTEXT_BUDGET_TOKENS=8000
BUDGET_SYSTEM=700
BUDGET_SESSION_SUMMARY=600
BUDGET_SECTION_SUMMARIES=1200
BUDGET_ROLLING_SUMMARY=800
BUDGET_MEMORIES=1800
BUDGET_OPEN_QUESTIONS=400
BUDGET_RECENT_MESSAGES=2500

# ===== Agent thresholds =====
CONTINUITY_TOP_K=5
CONTINUITY_SIMILARITY_THRESHOLD=0.55
GAP_MIN_YEARS=2
ARCHIVIST_MIN_IMPORTANCE=0.0
